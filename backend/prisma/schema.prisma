generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ProjectStatus {
  SAVED
  PLANNING
  IN_PROGRESS
  DONE
  HIDDEN
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  preference      UserPreference?
  projectStates   UserProjectState[]
  milestoneProgress ProjectMilestoneProgress[]
  sessions        UserSession[]
  otpVerifications OtpVerification[]
}

model UserPreference {
  id        String    @id @default(uuid())
  userId    String    @unique
  fields    String[]  @default([])
  level     SkillLevel @default(INTERMEDIATE)
  techStack String[]  @default([])
  goal      String    @default("Portfolio building")
  onboarded Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id               String   @id
  title            String
  field            String
  level            SkillLevel
  description      String
  problem          String
  features         String[]
  techStack        String[]
  duration         String
  goal             String
  portfolioValue   String
  learningOutcomes String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  roadmap ProjectRoadmap[]
  userStates UserProjectState[]

  @@index([field])
  @@index([level])
}

model ProjectRoadmap {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String
  sortOrder   Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progress ProjectMilestoneProgress[]

  @@unique([projectId, sortOrder])
}

model UserProjectState {
  id        String        @id @default(uuid())
  userId    String
  projectId String
  status    ProjectStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, status])
}

model ProjectMilestoneProgress {
  id          String   @id @default(uuid())
  userId      String
  milestoneId String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone ProjectRoadmap @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpVerification {
  id           String     @id @default(uuid())
  userId       String?
  email        String
  name         String?
  passwordHash String?
  codeHash     String
  purpose      OtpPurpose
  attempts     Int        @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, expiresAt])
}
